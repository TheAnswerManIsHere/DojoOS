{
  "$comment": "SYNCED FROM AI-Handbook — do not edit in a consumer repo. Local edits are overwritten by the next sync and their reasoning is lost; change the handbook instead. The schema scripts/map.mjs validates each .agents/map/*.json against; the contract is docs/ai-context/agent-legible-codebase.md.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "doc": { "type": "string", "minLength": 1 },
    "globs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "config": {
      "type": "object",
      "required": ["adopted", "enabled", "programs", "sets"],
      "patternProperties": { "^_": {} },
      "additionalProperties": false,
      "properties": {
        "adopted": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^_": {} },
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "tsconfig": { "type": "string", "minLength": 1 },
              "extends": { "type": "string", "minLength": 1 },
              "roots": { "$ref": "#/$defs/globs" },
              "compilerOptions": { "type": "object" }
            }
          }
        },
        "sets": {
          "type": "object",
          "required": ["indexed"],
          "additionalProperties": false,
          "properties": {
            "indexed": {
              "type": "object",
              "required": ["include"],
              "additionalProperties": false,
              "properties": { "include": { "$ref": "#/$defs/globs" }, "exclude": { "$ref": "#/$defs/globs" } }
            },
            "headered": { "type": "object", "additionalProperties": false, "properties": { "exclude": { "$ref": "#/$defs/globs" } } },
            "sized": { "type": "object", "additionalProperties": false, "properties": { "exclude": { "$ref": "#/$defs/globs" } } }
          }
        },
        "codegenOwned": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["paths", "command"],
            "additionalProperties": false,
            "properties": { "paths": { "$ref": "#/$defs/globs" }, "command": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "subsystems": {
      "type": "object",
      "required": ["adopted", "subsystems"],
      "patternProperties": { "^_": {} },
      "additionalProperties": false,
      "properties": {
        "adopted": { "type": "boolean" },
        "subsystems": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["doc"],
            "additionalProperties": false,
            "properties": { "doc": { "$ref": "#/$defs/doc" }, "infrastructure": { "type": "boolean" } }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["adopted", "packages"],
      "patternProperties": { "^_": {} },
      "additionalProperties": false,
      "properties": {
        "adopted": { "type": "boolean" },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "prefix"],
                  "additionalProperties": false,
                  "properties": { "name": { "type": "string", "minLength": 1 }, "prefix": { "type": "string", "minLength": 1 } }
                }
              },
              "allowLayers": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
            }
          }
        },
        "allowPackages": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "allowSubsystems": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "target", "dimension", "reason", "date"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "dimension": { "enum": ["package", "layer", "subsystem"] },
              "reason": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "sizeBaseline": {
      "type": "object",
      "required": ["adopted", "cap", "baselines"],
      "patternProperties": { "^_": {} },
      "additionalProperties": false,
      "properties": {
        "adopted": { "type": "boolean" },
        "cap": { "type": "integer", "minimum": 1 },
        "baselines": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "evalTasks": {
      "type": "object",
      "required": ["tasks"],
      "patternProperties": { "^_": {} },
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "tier", "question", "target"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "tier": { "enum": ["keyword", "structural", "hidden"] },
              "question": { "type": "string", "minLength": 1 },
              "hops": { "type": "integer", "minimum": 1 },
              "target": {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["symbol", "relation", "files"] },
                  "ref": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
                  "name": { "type": "string", "minLength": 1 },
                  "symbol": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
                  "files": { "$ref": "#/$defs/globs" }
                }
              }
            }
          }
        }
      }
    }
  }
}
